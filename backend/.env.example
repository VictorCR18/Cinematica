# --- Banco de dados (Neon Postgres) ---------------------------------------
# Crie um projeto gratuito em https://neon.tech
# DATABASE_URL: connection string "pooled" (usada em runtime pela aplicação)
# DIRECT_URL: connection string direta, sem pooling (usada pelas migrations do Prisma)
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/cinematica?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/cinematica?sslmode=require"

# --- Servidor ---------------------------------------------------------------
PORT=3333
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# --- Autenticação (JWT) ------------------------------------------------------
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="cinematica_token"

# --- TMDB (The Movie Database) ----------------------------------------------
# Crie uma chave gratuita em https://www.themoviedb.org/settings/api
TMDB_API_KEY=""
TMDB_BASE_URL="https://api.themoviedb.org/3"
TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p"
